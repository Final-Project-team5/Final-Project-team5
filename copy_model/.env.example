# 이 파일을 복사해 .env 로 만들고 값을 채우세요 (.env 는 커밋 금지).
#   cp .env.example .env   (Windows PowerShell: Copy-Item .env.example .env)

# 운영진이 전달한 팀 OpenAI API 키 (필수)
OPENAI_API_KEY=

# 선택 — 없으면 기본값 사용
# COPY_MODEL_NAME=gpt-5.4-mini
# COPY_MOCK=1            # 1이면 API 없이 고정 샘플 반환(비용 0, 프론트 연동 테스트용)
# COPY_CORS_ORIGINS=http://localhost:5173
